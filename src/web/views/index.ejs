<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurações</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Feather Icons -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
</head>

<body>
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="/">INTERSIG</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </header>
 

    <div class="container-fluid">
        <div class="row">
            <%- include('./components/sidebar', { activePage: 'configuracoes' }) %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 mt-4">
                
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2"> Mapeamento de produto</h1>
                </div>

                <!-- ALERTA DE SUCESSO -->
                <% if (typeof msgSucesso !== 'undefined' && msgSucesso) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
                        <span data-feather="check-circle"></span> Configurações atualizadas com sucesso!
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <!-- ALERTA DE ERRO -->
                <% if (typeof msgErro !== 'undefined' && msgErro) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <span data-feather="alert-triangle"></span> Erro ao salvar configurações.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

             

                <form action="/ajusteConfig" method="POST">
                    
                    <!-- Campo oculto para enviar o ID -->
                    <input type="hidden" name="id" value="<%= dataConfig.id %>">

                    <div class="row">



                         <!-- Select: Número do Fabricante -->
                        <div class="col-md-6 mb-3">
                            <label for="num_fabricante" class="form-label">Número do Fabricante (MOBILE)</label>
                            <select class="form-select" id="num_fabricante" name="num_fabricante" required>
                                <option value="" disabled>Selecione...</option>
                                <% options.forEach(opcao => { %>
                                    <option value="<%= opcao %>" <%= dataConfig.num_fabricante === opcao ? 'selected' : '' %>>
                                        <%= opcao %> (ERP)
                                    </option>
                                <% }) %>
                            </select>
                        </div>


                  
                        <!-- Número Original -->
                        <div class="col-md-6 mb-3">
                            <label for="num_original" class="form-label">Número Original (MOBILE)</label>

                             <select class="form-select" id="num_original" name="num_original" required>
                                <option value="" disabled>Selecione...</option>
                                <% options.forEach(opcao => { %>
                                    <option value="<%= opcao %>" <%= dataConfig.num_original === opcao ? 'selected' : '' %>>
                                        <%= opcao %> (ERP)
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <!-- SKU -->
                        <div class="col-md-6 mb-3">
                            <label for="sku" class="form-label">SKU (MOBILE)</label>
                               <select class="form-select" id="sku" name="sku" required>
                                <option value="" disabled>Selecione...</option>
                                <% options.forEach(opcao => { %>
                                    <option value="<%= opcao %>" <%= dataConfig.sku === opcao ? 'selected' : '' %>>
                                        <%= opcao %> (ERP)
                                    </option>
                                <% }) %>
                            </select>

                        </div>

                        <!-- Data da última atualização (Apenas leitura) -->
                        <div class="col-md-6 mb-3">
                            <label for="updated_at" class="form-label">Última Atualização</label>
                            <% 
                                // Formatando a data para o padrão brasileiro DD/MM/AAAA HH:MM
                                let dataFormatada = '';
                                if (dataConfig.updated_at) {
                                    let d = new Date(dataConfig.updated_at);
                                    dataFormatada = d.toLocaleString('pt-BR');
                                }
                            %>
                            <input type="text" class="form-control" id="updated_at" value="<%= dataFormatada %>" disabled>
                        </div>
                    </div>

                    <!-- Botão de Salvar -->
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            <span data-feather="save"></span> Salvar Alterações
                        </button>
                    </div>

                </form>


            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        feather.replace();

        // Opcional: Remover o alerta da URL para que se o usuário der F5 não apareça novamente
        if (window.history.replaceState) {
            const url = new URL(window.location);
            if(url.searchParams.get('sucesso') || url.searchParams.get('erro')){
                url.searchParams.delete('sucesso');
                url.searchParams.delete('erro');
                window.history.replaceState(null, '', url);
            }
        }
        
        // Auto-hide alert após 5 segundos
        setTimeout(function() {
            let alert = document.getElementById('successAlert');
            if (alert) {
                let bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 5000);
    </script>
</body>
</html>